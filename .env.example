# ============================================
# Archivo de configuración de entorno - Ejemplo
# ============================================
# Copiar a .env y ajustar valores para producción

# ============================================
# Configuración del Servidor
# ============================================
NODE_ENV=development
PORT=3000
HOST=localhost

# ============================================
# Base de Datos PostgreSQL
# ============================================
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=ecommerce_db
DB_PORT=5432

# ============================================
# Redis - Rate Limiting Distribuido
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CLUSTER=false

# ============================================
# Seguridad - JWT
# ============================================
JWT_SECRET=tu_jwt_secret_super_seguro_aqui_cambiar_en_produccion
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Email - Notificaciones
# ============================================
GMAIL_USER=tu_email@gmail.com
GMAIL_APP_PASSWORD=tu_app_password
VERIFICATION_CODE_EXPIRATION=600

# ============================================
# Rate Limiting - Límites
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX_REQUESTS=5
REGISTER_RATE_LIMIT_MAX_REQUESTS=3
VERIFICATION_RATE_LIMIT_MAX_REQUESTS=10
ADMIN_RATE_LIMIT_MAX_REQUESTS=50

# CORS - Dominios permitidos
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080,http://localhost:8081